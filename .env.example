# 이 파일에는 실제 비밀번호나 운영 URL을 넣지 않는다.
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# local Docker PostgreSQL 전용 예시값
POSTGRES_DB=app_local
POSTGRES_USER=app_local
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
# DATABASE_URL 이 있으면 앱은 PostgreSQL 에 저장하고, 비워 두면 서버 메모리에 저장한다(다시 켜면 처음 상태).
# 스키마는 `npm run db:migrate` 로 만든다. 그 명령은 APP_ENV 가 local 또는 test 일 때만 실행된다.
DATABASE_URL=postgresql://app_local:local-only-change-me@localhost:5432/app_local

# 애플리케이션이 운영 연결을 실수로 허용하지 않도록 사용하는 힌트다.
# 실제 강제는 배포 권한·네트워크·DB 계정 분리로 한다.
ALLOW_PRODUCTION_DB=false

# GitHub 연결 — 두 출처를 함께 쓸 수 있다(결정 12). 둘 다 적으면 한 번의 Sync 에 합치고, 같은 저장소는 App 으로 한 번만 읽는다.
# 둘 다 비어 있을 때만 고정 데이터(fixture)로 동작하며, 화면 위쪽에 출처가 표시된다.

# (1) GitHub App (결정 11) — 개인 계정 저장소를 읽는다. 만드는 법은 docs/setup/github-app.md.
# App ID · 설치 ID · 비밀 키가 모두 있어야 한다. 일부만 있으면 화면에 설정 오류가 뜬다.
# GITHUB_APP_ID: App 설정 화면 위쪽의 App ID 숫자
GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID: 설치 화면 주소 끝의 숫자 (https://github.com/settings/installations/<이 숫자>)
GITHUB_APP_INSTALLATION_ID=
# 비밀 키는 아래 둘 중 하나만 적는다(둘 다 적으면 설정 오류). .pem 은 저장소에 두지 않는다.
# GITHUB_APP_PRIVATE_KEY_PATH: 로컬용. 내려받은 비밀 키(.pem) 파일의 경로. 키 내용이 아니라 경로만 적는다.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY: 파일을 둘 수 없는 클라우드 환경용. .pem 파일 내용 전체(BEGIN · END 줄 포함).
#   한 줄만 받는 칸이면 그대로 붙여 넣는다(줄바꿈이 공백으로 바뀌거나 사라져도 읽는다). \n 두 글자나 base64 한 줄도 받는다.
#   실제 키는 이 파일에 적지 않는다.
GITHUB_APP_PRIVATE_KEY=

# (2) 토큰 — 사용자가 Owner 가 아닌 조직의 저장소를 사용자 권한으로 읽는다. 만드는 법은 docs/setup/org-token.md.
# GITHUB_TOKEN: fine-grained 토큰(읽기 전용). 실제 값은 .env.local 에만 넣는다. 채팅 · 저장소에 붙이지 않는다.
GITHUB_TOKEN=
# GITHUB_TOKEN_ORGS: 저장소를 모두 읽을 조직 이름(쉼표로 구분). 조직에 새 저장소가 생기면 다음 Sync 에 자동으로 들어온다.
#   fine-grained 토큰, Repository access 는 해당 조직의 All repositories,
#   권한은 Contents · Metadata · Pull requests · Checks · Commit statuses 읽기.
GITHUB_TOKEN_ORGS=
# GITHUB_REPOS: owner/name 을 쉼표로 구분한 저장소 목록. 저장소마다 프로젝트가 하나씩 만들어진다.
#   토큰 출처에서는 조직 목록에 더해 읽을 저장소, App 출처에서는 설치된 저장소 중 이것만 읽는 거르개다.
#   GITHUB_TOKEN 이 있으면 GITHUB_TOKEN_ORGS 와 GITHUB_REPOS 중 하나 이상이 있어야 한다(둘 다 없으면 설정 오류).
GITHUB_REPOS=

# 주기 동기화 (결정 11, feature-plan F6) — 서버가 이 간격(초)마다 GitHub 를 읽는다. 비워 두면 300(5분), 0 이면 끈다.
#   30 보다 짧게 적으면 30 으로 올린다(GitHub 요청 한도). Sync 버튼은 간격과 무관하게 언제든 쓸 수 있다.
SYNC_INTERVAL_SECONDS=

# 미리보기 (2단계, docs/plan/04-remote-preview.md) — 이 컴퓨터에서 PR 커밋 하나를 실행해 연다.
# PREVIEW_WORKDIR: 격리 폴더들의 부모(절대 경로). 비워 두면 미리보기 기기가 "연결 안 됨"이고 Open Preview 는 비활성이다.
#   이 폴더는 Studio 하나만 쓴다(Studio 가 켜질 때 남은 preview-* 폴더를 지운다).
PREVIEW_WORKDIR=
# PREVIEW_BIND_HOST: 미리보기 앱에 HOST · HOSTNAME 으로 넘길 주소. 휴대전화로 보려면 사설망(Tailscale 류)의 주소. 공개 주소는 쓰지 않는다.
PREVIEW_BIND_HOST=127.0.0.1
# PREVIEW_PUBLIC_HOST: 화면에 보일 미리보기 주소의 호스트(예: Mac Pro 의 사설망 이름). 비우면 PREVIEW_BIND_HOST.
PREVIEW_PUBLIC_HOST=
# PREVIEW_ALLOWED_DEV_ORIGINS: Studio 를 휴대전화(사설망 주소)로 열 때 그 주소. 쉼표로 여럿. 미리보기 앱에는 실행기가 알아서 넘긴다.
PREVIEW_ALLOWED_DEV_ORIGINS=
# PREVIEW_LOCAL_REPOS_DIR: 시연 · 시험용. 코드를 GitHub 대신 이 폴더의 로컬 git 저장소(<owner>/<name>)에서 받는다.
#   고정 데이터로 시연하려면 `npm run preview:demo-repo -- <절대 경로>` 로 시연 저장소를 만들고 그 경로를 적는다.
PREVIEW_LOCAL_REPOS_DIR=

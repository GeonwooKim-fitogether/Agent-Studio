# 이 파일에는 실제 비밀번호나 운영 URL을 넣지 않는다.
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# local Docker PostgreSQL 전용 예시값
POSTGRES_DB=app_local
POSTGRES_USER=app_local
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
# DATABASE_URL 이 있으면 앱은 PostgreSQL 에 저장하고, 비워 두면 서버 메모리에 저장한다(다시 켜면 처음 상태).
# 스키마는 `npm run db:migrate` 로 만든다. 그 명령은 APP_ENV 가 local 또는 test 일 때만 실행된다.
DATABASE_URL=postgresql://app_local:local-only-change-me@localhost:5432/app_local

# 애플리케이션이 운영 연결을 실수로 허용하지 않도록 사용하는 힌트다.
# 실제 강제는 배포 권한·네트워크·DB 계정 분리로 한다.
ALLOW_PRODUCTION_DB=false

# GitHub App 연결 (결정 11) — 진짜 저장소를 읽는 정식 경로. 만드는 법은 docs/setup/github-app.md.
# 세 값이 모두 있으면 GitHub App 으로 읽는다(아래 개인 토큰보다 먼저). 일부만 있으면 화면에 설정 오류가 뜬다.
# GITHUB_APP_ID: App 설정 화면 위쪽의 App ID 숫자
GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID: 설치 화면 주소 끝의 숫자 (https://github.com/settings/installations/<이 숫자>)
GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH: 내려받은 비밀 키(.pem) 파일의 경로. 키 내용이 아니라 경로만 적는다. .pem 은 저장소에 두지 않는다.
GITHUB_APP_PRIVATE_KEY_PATH=

# 개인 토큰 연결 (개발용). App 변수가 없을 때만 쓴다.
# GITHUB_REPOS 는 App 모드에서도 쓰이며, 그때는 설치된 저장소 중 적힌 것만 읽는다.
# GitHub 읽기 전용 연결 (1단계). 두 값이 모두 채워졌을 때만 앱이 GitHub REST API 를 GET 으로 읽는다.
# 하나라도 비어 있으면 고정 데이터(fixture)로 동작하며, 화면 위쪽에 출처가 표시된다.
# GITHUB_TOKEN: 읽기 권한만 준 토큰(Pull requests · Checks · Contents 읽기). 실제 값은 .env.local 에만 넣는다.
GITHUB_TOKEN=
# GITHUB_REPOS: 읽을 저장소 목록. owner/name 을 쉼표로 구분한다. 저장소마다 프로젝트가 하나씩 만들어진다.
GITHUB_REPOS=

# 이 파일에는 실제 비밀번호나 운영 URL을 넣지 않는다.
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# local Docker PostgreSQL 전용 예시값
POSTGRES_DB=app_local
POSTGRES_USER=app_local
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
# 앱은 아직 DATABASE_URL 을 읽지 않는다. 1단계 첫 단위의 저장은 서버 메모리이고, PostgreSQL 저장은 다음 단위에서 붙는다.
DATABASE_URL=postgresql://app_local:local-only-change-me@localhost:5432/app_local

# 애플리케이션이 운영 연결을 실수로 허용하지 않도록 사용하는 힌트다.
# 실제 강제는 배포 권한·네트워크·DB 계정 분리로 한다.
ALLOW_PRODUCTION_DB=false

# GitHub 읽기 전용 연결 (1단계). 두 값이 모두 채워졌을 때만 앱이 GitHub REST API 를 GET 으로 읽는다.
# 하나라도 비어 있으면 고정 데이터(fixture)로 동작하며, 화면 위쪽에 출처가 표시된다.
# GITHUB_TOKEN: 읽기 권한만 준 토큰(Pull requests · Checks · Contents 읽기). 실제 값은 .env.local 에만 넣는다.
GITHUB_TOKEN=
# GITHUB_REPOS: 읽을 저장소 목록. owner/name 을 쉼표로 구분한다. 저장소마다 프로젝트가 하나씩 만들어진다.
GITHUB_REPOS=

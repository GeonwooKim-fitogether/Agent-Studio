# Windows / OneDrive folder metadata
desktop.ini
Thumbs.db
.DS_Store

# Dependencies
node_modules/

__pycache__/
*.pyc

# 회차 사실은 사건마다 수집기가 새로 쓴다(.github/workflows/integration-board.yml).
# 저장소에 두면 커밋된 옛 사실과 방금 모은 사실 두 벌이 생기고, 어느 쪽이 지금인지
# 화면만 보고는 알 수 없다. 그래서 설정(board.config.json·board.map.json)만 저장소가
# 소유하고, 사실은 소유하지 않는다.
.integration/board.json

# 엔진이 만드는 산출물. 게시는 Pages 가 맡는다.
integration-board.html
_site/

# Generated dashboard output (produced per-project by the progress-dashboard skill)
.claude/progress-dashboard.html
.claude/progress-dashboard.body.html

# 데이터베이스 쓰기 허가용 일회용 열쇠(.claude/rules/db-write-permission.md).
# 사용자가 승인한 그 순간에만 존재했다가 쓰이면 사라지는 파일이므로, 저장소에
# 들어가면 안 된다. 커밋되는 순간 "항상 열려 있는 열쇠"가 되어 장치가 무력해진다.
.claude/sql-write-unlock

# ── 앱 (Next.js · TypeScript · 테스트) ──────────────────────────────────────
# 빌드 산출물과 TypeScript 가 만드는 파일. next-env.d.ts 는 `npm run typecheck` 가 `next typegen` 으로 다시 만든다.
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# 로컬 비밀값. `.env.example` 은 값 없는 목록이라 커밋하고, 실제 값은 `.env.local` 에만 둔다.
.env
.env.local
.env.*.local

# Playwright 산출물. 보고용 스크린샷은 docs/plan/screenshots/ 에 따로 저장해 커밋한다.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/coverage/

# GitHub App 비밀 키. 저장소에 올리지 않는다 (docs/setup/github-app.md)
*.pem
